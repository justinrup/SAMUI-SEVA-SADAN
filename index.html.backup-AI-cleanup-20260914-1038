.sss-fixed-date-display{font-size:17px;font-weight:700;color:#667;}
.sss-date-field{display:flex;align-items:center;gap:8px;position:relative;margin-bottom:12px}
.sss-date-field{display:flex;align-items:center;gap:8px;}
.sss-date-parts{display:grid;grid-template-columns:1fr 1fr 1.35fr;gap:7px;flex:1;}
.sss-date-parts select,.sss-fixed-date-part{width:100%;box-sizing:border-box;padding:11px 8px;border:1px solid #d7e1e7;border-radius:10px;background:#fff;font-weight:700;font-size:14px;text-align:center;}
.sss-current-date-fixed .sss-fixed-date-part{background:#eef3f5;color:#344955;cursor:not-allowed;user-select:none;}
.sss-date-parts{display:grid;grid-template-columns:1fr 1fr 1.35fr;gap:7px;flex:1}
