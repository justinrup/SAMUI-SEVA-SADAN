const shut = ()=>{ const menu=document.getElementById("sssSideMenu"); const overlay=document.getElementById("sssMenuOverlay"); if(menu) menu.classList.remove("open"); if(overlay) overlay.classList.remove("show"); document.body.classList.remove("menu-open"); };
