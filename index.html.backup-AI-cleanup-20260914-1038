@keyframes sssPulse{0%,100%{transform:scale(1)}50%{transform:scale(1.08)}}
.sss-notification-badge{position:absolute;right:-2px;top:-2px;background:#ffd54f;color:#6b4200;border-radius:50%;min-width:17px;height:17px;display:none;align-items:center;justify-content:center;font-size:11px;font-weight:900}

