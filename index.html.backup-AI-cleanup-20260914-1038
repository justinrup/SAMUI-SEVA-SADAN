/* Android-style DOB wheel picker */
.sss-dob-field{display:flex;align-items:center;gap:10px;cursor:pointer;}
.sss-dob-field:active{background:#f4fbff;}
.sss-dob-picker{position:fixed;inset:0;display:none;align-items:center;justify-content:center;background:rgba(0,0,0,.62);z-index:100001;padding:18px;}
.sss-dob-picker.show{display:flex;}
.sss-dob-picker-card{width:min(505px,94vw);background:#fff;border-radius:8px;overflow:hidden;box-shadow:0 18px 60px rgba(0,0,0,.4);}
.sss-dob-picker-top{background:#078f82;color:#fff;padding:18px 24px 22px;}
.sss-dob-picker-top>div:first-child{font-size:17px;font-weight:700;opacity:.95;}
.sss-dob-picker-top>div:last-child{font-size:34px;font-weight:700;margin-top:5px;}
.sss-dob-wheel-wrap{height:270px;position:relative;display:grid;grid-template-columns:1fr 1.35fr 1.25fr;overflow:hidden;background:#fff;padding:0 16px;}
.sss-dob-wheel-highlight{position:absolute;left:16px;right:16px;top:108px;height:54px;border-top:2px solid #222;border-bottom:2px solid #222;pointer-events:none;z-index:2;}
.sss-dob-wheel{height:270px;overflow-y:auto;scroll-snap-type:y mandatory;scrollbar-width:none;text-align:center;position:relative;z-index:1;}
.sss-dob-wheel::-webkit-scrollbar{display:none;}
.sss-dob-wheel:before,.sss-dob-wheel:after{content:"";display:block;height:108px;}
.sss-dob-wheel button{display:block;width:100%;height:54px;border:0;background:transparent;font-size:22px;color:#aaa;scroll-snap-align:center;padding:0;}
.sss-dob-wheel button.active{color:#111;font-weight:700;}
.sss-dob-picker-actions{display:grid;grid-template-columns:1fr 1fr 1fr;border-top:1px solid #ddd;}
.sss-dob-picker-actions button{height:64px;border:0;border-right:1px solid #ddd;background:#fff;color:#075985;font-size:18px;font-weight:700;}
.sss-dob-picker-actions button:last-child{border-right:0;}
.sss-dob-date-input{display:none;}
.sss-current-date-fixed{display:flex;align-items:center;gap:10px;cursor:default;user-select:none;pointer-events:none;}
