})();

  // ===== 3-DOT TOOLS =====
  

    /* ===== ASK AI JS ===== */

    const askAiMenu = document.getElementById("sssAskAiMenu");
    if (askAiMenu) {
      askAiMenu.addEventListener("click", (e) => {
        e.preventDefault();
        shut();
        openTool("sssAskAiModal");
      });
    }

    /* ===== BANKING MENU JS ===== */
    const bankingMenu = document.getElementById("sssBankingMenu");
    const bankingSubMenu = document.getElementById("sssBankingSubMenu");
    const upiMenu = document.getElementById("sssUpiMenu");

    if (bankingMenu && bankingSubMenu) {
      bankingMenu.addEventListener("click", (e) => {
        e.preventDefault();
        const isOpen = bankingSubMenu.style.display !== "none";
        bankingSubMenu.style.display = isOpen ? "none" : "block";
      });
    }

    if (upiMenu) {
      upiMenu.addEventListener("click", (e) => {
        e.preventDefault();
        shut();
        openTool("sssUpiModal");
      });
    }

    const toolMap = {
    sssCalendarMenu: "sssCalendarModal",
    sssCalculatorMenu: "sssCalculatorModal",
    sssAgeCalculatorMenu: "sssAgeCalculatorModal",
    sssWeatherMenu: "sssWeatherModal",
    sssNoticeMenu: "sssNoticeModal"
  };
  function openTool(id){
    const el=document.getElementById(id);
    if(el) el.classList.add("show");
  }
  function closeTool(id){
    const el=document.getElementById(id);
    if(el) el.classList.remove("show");
  }
  Object.entries(toolMap).forEach(([menuId,modalId])=>{
    const a=document.getElementById(menuId);
    if(a) a.addEventListener("click",e=>{
      e.preventDefault();
      shut();
      openTool(modalId);
      if(modalId==="sssWeatherModal") loadLiveWeather();
      if(modalId==="sssNoticeModal") loadPublishedNotices();
    });
  });
  document.querySelectorAll("[data-close-tool]").forEach(b=>b.addEventListener("click",()=>closeTool(b.dataset.closeTool)));
  document.querySelectorAll(".sss-tools-modal").forEach(m=>m.addEventListener("click",e=>{if(e.target===m)m.classList.remove("show");}));

  // Calendar
  const calDate=document.getElementById("sssCalendarDate");
  const calResult=document.getElementById("sssCalendarResult");
  function updateCalendar(){
    if(!calDate.value){calResult.textContent="Select a date.";return;}
    const d=new Date(calDate.value+"T00:00:00");
    calResult.innerHTML="<b>"+d.toLocaleDateString("en-IN",{weekday:"long",day:"numeric",month:"long",year:"numeric"})+"</b>";
  }
  if(calDate){calDate.value=new Date().toISOString().slice(0,10);calDate.addEventListener("change",updateCalendar);updateCalendar();}

  // Calculator
  let calcExpr="";
  const calcDisplay=document.getElementById("sssCalcDisplay");
  document.querySelectorAll("[data-calc]").forEach(btn=>btn.addEventListener("click",()=>{
    const v=btn.dataset.calc;
    if(v==="C") calcExpr="";
    else if(v==="⌫") calcExpr=calcExpr.slice(0,-1);
    else if(v==="="){
      try{
        if(!/^[0-9+*/().\s-]+$/.test(calcExpr)) throw new Error();
        calcExpr=String(Function("return ("+calcExpr+")")());
      }catch(e){calcExpr="Error";}
    } else if(calcExpr==="Error") calcExpr=v;
    else calcExpr+=v;
    calcDisplay.value=calcExpr||"0";
  }));

  // Age calculator — DOB uses a real scrollable DD / Month / YYYY wheel picker.
  // Current Date is always the device date, locked and never editable.
  const ageBtn=document.getElementById("sssAgeCalcBtn");
  const dobOpen=document.getElementById("sssDobOpen");
  const dobDisplay=document.getElementById("sssDobDisplay");
  const dobPicker=document.getElementById("sssDobPicker");
  const dayWheel=document.getElementById("sssDobDayWheel");
  const monthWheel=document.getElementById("sssDobMonthWheel");
  const yearWheel=document.getElementById("sssDobYearWheel");
  const pickerYear=document.getElementById("sssDobPickerYear");
  const pickerBig=document.getElementById("sssDobPickerBig");
  const monthNames=["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];

  function pad2(n){return String(n).padStart(2,"0");}
  function getTodayParts(){
    const n=new Date();
    return {day:n.getDate(),month:n.getMonth()+1,year:n.getFullYear()};
  }
  function formatDate(d,m,y){return pad2(d)+"/"+pad2(m)+"/"+y;}

  let selectedDob=null;
  let draftDob=null;
  let scrollTimers=new WeakMap();

  function updateFixedCurrentDate(){
    const t=getTodayParts();
    const el=document.getElementById("sssCurrentDateDisplay");
    if(el) el.textContent=formatDate(t.day,t.month,t.year);
    return t;
  }
  updateFixedCurrentDate();

  function daysInMonth(y,m){return new Date(y,m,0).getDate();}

  function updatePickerHeader(){
    if(!draftDob)return;
    pickerYear.textContent=draftDob.year;
    pickerBig.textContent=pad2(draftDob.day)+" "+monthNames[draftDob.month-1]+" "+draftDob.year;
  }

  function setActive(wheel,index){
    wheel.querySelectorAll("button").forEach((b,i)=>b.classList.toggle("active",i===index));
  }

  function syncWheelFromScroll(wheel){
    if(!draftDob || !wheel.__values || wheel.__syncing)return;
    const values=wheel.__values;
    const index=Math.max(0,Math.min(values.length-1,Math.round(wheel.scrollTop/54)));
    const value=values[index];

    if(wheel===dayWheel) draftDob.day=value;
    if(wheel===monthWheel){
      draftDob.month=value;
      draftDob.day=Math.min(draftDob.day,daysInMonth(draftDob.year,draftDob.month));
    }
    if(wheel===yearWheel){
      draftDob.year=value;
      draftDob.day=Math.min(draftDob.day,daysInMonth(draftDob.year,draftDob.month));
    }

    setActive(wheel,index);
    updatePickerHeader();

    // If month/year changed and the selected day became invalid, update only the day wheel.
    if(wheel!==dayWheel){
      const maxDay=daysInMonth(draftDob.year,draftDob.month);
      if(draftDob.day>maxDay) draftDob.day=maxDay;
      if(dayWheel.__values && dayWheel.__values.length!==maxDay){
        renderDobWheels();
        return;
      }
      if(dayWheel.__values){
        const di=dayWheel.__values.indexOf(draftDob.day);
        if(di>=0){
          dayWheel.__syncing=true;
          dayWheel.scrollTop=di*54;
          setActive(dayWheel,di);
          requestAnimationFrame(()=>dayWheel.__syncing=false);
        }
      }
    }
  }

  function attachWheelScroll(wheel){
    if(wheel.__scrollAttached)return;
    wheel.__scrollAttached=true;
    wheel.addEventListener("scroll",()=>{
      clearTimeout(scrollTimers.get(wheel));
      scrollTimers.set(wheel,setTimeout(()=>{
        const idx=Math.max(0,Math.min((wheel.__values||[]).length-1,Math.round(wheel.scrollTop/54)));
        wheel.__syncing=true;
        wheel.scrollTop=idx*54;
        requestAnimationFrame(()=>{
          wheel.__syncing=false;
          syncWheelFromScroll(wheel);
        });
      },90));
    },{passive:true});
  }

  function wheelItems(wheel,values,selected){
    wheel.innerHTML="";
    wheel.__values=values;
    attachWheelScroll(wheel);

    values.forEach((v,i)=>{
      const b=document.createElement("button");
      b.type="button";
      b.dataset.value=v;
      b.textContent=(wheel===monthWheel?monthNames[v-1]:String(v).padStart(2,"0"));
      if(v===selected)b.classList.add("active");
      b.addEventListener("click",()=>{
        draftDob=draftDob||getTodayParts();
        if(wheel===dayWheel)draftDob.day=v;
        if(wheel===monthWheel){
          draftDob.month=v;
          draftDob.day=Math.min(draftDob.day,daysInMonth(draftDob.year,draftDob.month));
        }
        if(wheel===yearWheel){
          draftDob.year=v;
          draftDob.day=Math.min(draftDob.day,daysInMonth(draftDob.year,draftDob.month));
        }
        renderDobWheels();
      });
      wheel.appendChild(b);
    });

    const idx=Math.max(0,values.indexOf(selected));
    wheel.__syncing=true;
    wheel.scrollTop=idx*54;
    setActive(wheel,idx);
    requestAnimationFrame(()=>wheel.__syncing=false);
  }

  function renderDobWheels(){
    if(!draftDob)draftDob=getTodayParts();
    const today=getTodayParts();
    const maxYear=today.year;
    const minYear=1900;
    const maxDay=daysInMonth(draftDob.year,draftDob.month);
    draftDob.day=Math.min(draftDob.day,maxDay);

    wheelItems(dayWheel,Array.from({length:maxDay},(_,i)=>i+1),draftDob.day);
    wheelItems(monthWheel,Array.from({length:12},(_,i)=>i+1),draftDob.month);
    wheelItems(yearWheel,Array.from({length:maxYear-minYear+1},(_,i)=>maxYear-i),draftDob.year);
    updatePickerHeader();
  }

  function openDobPicker(){
    const t=getTodayParts();
    draftDob=selectedDob ? {...selectedDob} : {day:t.day,month:t.month,year:t.year};
    renderDobWheels();
    dobPicker.classList.add("show");
    dobPicker.setAttribute("aria-hidden","false");
  }

  function closeDobPicker(){
    dobPicker.classList.remove("show");
    dobPicker.setAttribute("aria-hidden","true");
  }

  if(dobOpen)dobOpen.addEventListener("click",openDobPicker);

  document.getElementById("sssDobCancel")?.addEventListener("click",closeDobPicker);

  document.getElementById("sssDobClear")?.addEventListener("click",()=>{
    selectedDob=null;
    dobDisplay.textContent="DD/MM/YYYY";
    closeDobPicker();
  });

  document.getElementById("sssDobSet")?.addEventListener("click",()=>{
    if(!draftDob)return;
    selectedDob={...draftDob};
    dobDisplay.textContent=formatDate(selectedDob.day,selectedDob.month,selectedDob.year);
    closeDobPicker();
  });

  function calculateAgeNow(){
    const out=document.getElementById("sssAgeResult");
    if(!out)return;

    // Current date is taken fresh from the device. There is no editable current-date control.
    const today=updateFixedCurrentDate();

    if(!selectedDob){
      out.innerHTML="⚠️ <b>Please select your Date of Birth first.</b>";
      return;
    }

    const dob=new Date(selectedDob.year,selectedDob.month-1,selectedDob.day);
    const now=new Date(today.year,today.month-1,today.day);

    if(dob>now){
      out.innerHTML="⚠️ <b>Date of Birth cannot be in the future.</b>";
      return;
    }

    let years=today.year-selectedDob.year;
    let months=today.month-selectedDob.month;
    let days=today.day-selectedDob.day;

    if(days<0){
      months--;
      days+=new Date(today.year,today.month-1,0).getDate();
    }
    if(months<0){
      years--;
      months+=12;
    }

    out.innerHTML="🎉 <b>Age: "+years+" Years, "+months+" Months, "+days+" Days</b>";
  }

  if(ageBtn)ageBtn.addEventListener("click",calculateAgeNow);

  // Live weather dashboard — searchable by city/place using Open-Meteo
  const weatherBox=document.getElementById("sssWeatherResult");
  const weatherIconMap={0:"☀️",1:"🌤️",2:"⛅",3:"☁️",45:"🌫️",48:"🌫️",51:"🌦️",53:"🌦️",55:"🌧️",61:"🌦️",63:"🌧️",65:"🌧️",71:"🌨️",73:"❄️",75:"❄️",80:"🌦️",81:"🌧️",82:"🌧️",95:"⛈️",96:"⛈️",99:"⛈️"};
  const weatherTextMap={
    en:{0:"Clear sky",1:"Mainly clear",2:"Partly cloudy",3:"Overcast",45:"Fog",48:"Rime fog",51:"Light drizzle",53:"Drizzle",55:"Heavy drizzle",61:"Light rain",63:"Rain",65:"Heavy rain",71:"Light snow",73:"Snow",75:"Heavy snow",80:"Rain showers",81:"Rain showers",82:"Heavy rain showers",95:"Thunderstorm",96:"Thunderstorm with hail",99:"Thunderstorm with hail"},
    bn:{0:"পরিষ্কার আকাশ",1:"প্রধানত পরিষ্কার",2:"আংশিক মেঘলা",3:"মেঘাচ্ছন্ন",45:"কুয়াশা",48:"কুয়াশা",51:"হালকা গুঁড়ি গুঁড়ি বৃষ্টি",53:"গুঁড়ি গুঁড়ি বৃষ্টি",55:"ভারী গুঁড়ি গুঁড়ি বৃষ্টি",61:"হালকা বৃষ্টি",63:"বৃষ্টি",65:"ভারী বৃষ্টি",71:"হালকা তুষার",73:"তুষারপাত",75:"ভারী তুষারপাত",80:"বৃষ্টির ঝরনা",81:"বৃষ্টির ঝরনা",82:"ভারী বৃষ্টির ঝরনা",95:"বজ্রঝড়",96:"শিলাসহ বজ্রঝড়",99:"শিলাসহ বজ্রঝড়"},
    hi:{0:"साफ़ आसमान",1:"मुख्यतः साफ़",2:"आंशिक बादल",3:"बादल छाए",45:"कोहरा",48:"कोहरा",51:"हल्की बूंदाबांदी",53:"बूंदाबांदी",55:"तेज़ बूंदाबांदी",61:"हल्की बारिश",63:"बारिश",65:"तेज़ बारिश",71:"हल्की बर्फ़",73:"बर्फ़बारी",75:"तेज़ बर्फ़बारी",80:"बारिश की फुहार",81:"बारिश की फुहार",82:"तेज़ बारिश की फुहार",95:"आंधी-तूफ़ान",96:"ओलों के साथ आंधी",99:"ओलों के साथ आंधी"}
  };
  const weatherLabels={
    en:{search:"Search city or place...",searching:"Searching weather for",now:"Now",feels:"Feels like",rain:"Rain chance",wind:"Wind",humidity:"Humidity",sun:"Sunrise / Sunset",weather:"Weather",loading:"Weather loading...",current:"Current weather",notfound:"Place not found. Try another city or area.",permission:"Search a city or place to see live weather.",location:"Your location"},
    bn:{search:"শহর বা এলাকার নাম লিখুন...",searching:"আবহাওয়া খোঁজা হচ্ছে",now:"এখন",feels:"অনুভূত হচ্ছে",rain:"বৃষ্টির সম্ভাবনা",wind:"বাতাস",humidity:"আর্দ্রতা",sun:"সূর্যোদয় / সূর্যাস্ত",weather:"আবহাওয়া",loading:"আবহাওয়া লোড হচ্ছে...",current:"বর্তমান আবহাওয়া",notfound:"এলাকা পাওয়া যায়নি। অন্য শহর বা এলাকার নাম চেষ্টা করুন।",permission:"আবহাওয়া দেখতে শহর বা এলাকার নাম লিখুন।",location:"আপনার অবস্থান"},
    hi:{search:"शहर या स्थान खोजें...",searching:"मौसम खोजा जा रहा है",now:"अभी",feels:"महसूस हो रहा",rain:"बारिश की संभावना",wind:"हवा",humidity:"नमी",sun:"सूर्योदय / सूर्यास्त",weather:"मौसम",loading:"मौसम लोड हो रहा है...",current:"वर्तमान मौसम",notfound:"स्थान नहीं मिला। दूसरा शहर या क्षेत्र आज़माएँ।",permission:"मौसम देखने के लिए शहर या स्थान खोजें।",location:"आपका स्थान"}
  };
  let weatherLang=localStorage.getItem("sssWeatherLang")||"bn";
  function wl(key){return (weatherLabels[weatherLang]||weatherLabels.bn)[key]||key;}
  function weatherText(code){return (weatherTextMap[weatherLang]||weatherTextMap.bn)[code]||(weatherLabels[weatherLang]||weatherLabels.bn).current;}
  function dayName(dateStr){
    const locale=weatherLang==="bn"?"bn-IN":weatherLang==="hi"?"hi-IN":"en-IN";
    return new Date(dateStr+"T12:00:00").toLocaleDateString(locale,{weekday:"short"});
  }
  function hourLabel(dateStr){
    const locale=weatherLang==="bn"?"bn-IN":weatherLang==="hi"?"hi-IN":"en-IN";
    return new Date(dateStr).toLocaleTimeString(locale,{hour:"numeric"});
  }
  function timeLabel(dateStr){
    const locale=weatherLang==="bn"?"bn-IN":weatherLang==="hi"?"hi-IN":"en-IN";
    return new Date(dateStr).toLocaleTimeString(locale,{hour:"numeric",minute:"2-digit"});
  }
  function weatherLanguageControl(){
    return "<div class='sss-weather-lang'><label for='sssWeatherLang'>🌐</label><select id='sssWeatherLang'><option value='bn'"+(weatherLang==="bn"?" selected":"")+">বাংলা</option><option value='en'"+(weatherLang==="en"?" selected":"")+">English</option><option value='hi'"+(weatherLang==="hi"?" selected":"")+">हिन्दी</option></select></div>";
  }
  function attachWeatherLanguage(){
    const lang=document.getElementById("sssWeatherLang");
    if(lang) lang.addEventListener("change",async e=>{
      weatherLang=e.target.value; localStorage.setItem("sssWeatherLang",weatherLang);
      if(window.sssLastWeatherPlace && window.sssLastWeatherData) renderWeather(window.sssLastWeatherPlace,window.sssLastWeatherData);
      else loadLiveWeather();
    });
  }
  async function findWeatherPlace(q){
    const url="https://geocoding-api.open-meteo.com/v1/search?name="+encodeURIComponent(q)+"&count=1&language=en&format=json";
    const r=await fetch(url); if(!r.ok) throw new Error("Place search failed");
    const j=await r.json();
    if(!j.results||!j.results.length) throw new Error("Place not found");
    return j.results[0];
  }
  async function fetchWeather(place){
    const url="https://api.open-meteo.com/v1/forecast?latitude="+place.latitude+"&longitude="+place.longitude+
      "&current=temperature_2m,relative_humidity_2m,apparent_temperature,weather_code,wind_speed_10m"+
      "&hourly=temperature_2m,weather_code,precipitation_probability"+
      "&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,sunrise,sunset"+
      "&forecast_days=7&timezone=auto";
    const r=await fetch(url); if(!r.ok) throw new Error("Weather request failed");
    return await r.json();
  }
  function renderWeather(place,j){
    window.sssLastWeatherPlace=place; window.sssLastWeatherData=j;
    const c=j.current, h=j.hourly, d=j.daily;
    const nowIndex=Math.max(0,h.time.findIndex(t=>t>=c.time));
    const start=nowIndex<0?0:nowIndex;
    let hourly="";
    for(let i=start;i<Math.min(start+8,h.time.length);i++){
      hourly+="<div class='sss-hour-card'><b>"+(i===start?wl("now"):hourLabel(h.time[i]))+"</b><div class='wi'>"+(weatherIconMap[h.weather_code[i]]||"🌤️")+"</div><span>"+Math.round(h.temperature_2m[i])+"°</span></div>";
    }
    let days="";
    for(let i=0;i<d.time.length;i++){
      days+="<div class='sss-day-card "+(i===0?"active":"")+"'><strong>"+dayName(d.time[i])+"</strong><div class='wi'>"+(weatherIconMap[d.weather_code[i]]||"🌤️")+"</div><span>"+Math.round(d.temperature_2m_max[i])+"° / "+Math.round(d.temperature_2m_min[i])+"°</span></div>";
    }
    weatherBox.innerHTML=weatherLanguageControl()+
      "<div class='sss-weather-search'><input id='sssWeatherSearch' type='search' placeholder='"+wl("search")+"' value='"+String(place.name||"").replace(/"/g,"&quot;")+"' autocomplete='off'><button id='sssWeatherSearchBtn'>🔍</button></div>"+
      "<div class='sss-weather-place'>📍 "+place.name+(place.admin1?", "+place.admin1:"")+(place.country?", "+place.country:"")+"</div>"+
      "<div class='sss-weather-main'><div class='sss-weather-current'><div><div class='sss-weather-temp'>"+Math.round(c.temperature_2m)+"°</div><div class='sss-weather-condition'>"+weatherText(c.weather_code)+" · "+wl("feels")+" "+Math.round(c.apparent_temperature)+"°</div></div><div class='sss-weather-icon'>"+(weatherIconMap[c.weather_code]||"🌤️")+"</div></div>"+
      "<div class='sss-weather-hourly'>"+hourly+"</div><div class='sss-weather-days'>"+days+"</div>"+
      "<div class='sss-weather-details'><div class='sss-weather-detail'>🌧️ "+wl("rain")+"<b>"+(h.precipitation_probability[start]||0)+"%</b></div><div class='sss-weather-detail'>💨 "+wl("wind")+"<b>"+Math.round(c.wind_speed_10m)+" km/h</b></div><div class='sss-weather-detail'>💧 "+wl("humidity")+"<b>"+c.relative_humidity_2m+"%</b></div><div class='sss-weather-detail'>🌅 "+wl("sun")+"<b>"+timeLabel(d.sunrise[0])+" / "+timeLabel(d.sunset[0])+"</b></div></div></div>";
    attachWeatherLanguage();
    const search=document.getElementById("sssWeatherSearch"), searchBtn=document.getElementById("sssWeatherSearchBtn");
    async function doSearch(){
      const q=search.value.trim(); if(!q) return;
      weatherBox.innerHTML=weatherLanguageControl()+"<div class='sss-weather-loading'>🔎 "+wl("searching")+" <b>"+q+"</b>...</div>"; attachWeatherLanguage();
      try{const pl=await findWeatherPlace(q); const data=await fetchWeather(pl); renderWeather(pl,data);}
      catch(e){weatherBox.innerHTML=weatherLanguageControl()+"<div class='sss-weather-loading'>❌ "+wl("notfound")+"</div>"; attachWeatherLanguage();}
    }
    searchBtn.addEventListener("click",doSearch); search.addEventListener("keydown",e=>{if(e.key==="Enter") doSearch();});
  }
  async function loadLiveWeather(){
    weatherBox.innerHTML=weatherLanguageControl()+"<div class='sss-weather-loading'>📍 "+wl("loading")+"</div>"; attachWeatherLanguage();
    try{
      if(navigator.geolocation){
        await new Promise((resolve,reject)=>navigator.geolocation.getCurrentPosition(async pos=>{
          try{const place={name:wl("location"),latitude:pos.coords.latitude,longitude:pos.coords.longitude,country:""}; const data=await fetchWeather(place); renderWeather(place,data); resolve();}catch(e){reject(e);}
        },reject,{enableHighAccuracy:false,timeout:8000}));
      }else throw new Error();
    }catch(e){
      try{const place=await findWeatherPlace("Khanakul"); const data=await fetchWeather(place); renderWeather(place,data);}
      catch(err){weatherBox.innerHTML=weatherLanguageControl()+"<div class='sss-weather-loading'>🌤️ "+wl("permission")+"</div>"; attachWeatherLanguage();}
    }
  }

  // Published Notice + front notification
  async function getPublishedNotices(){
    const snapshot=await getDocs(collection(db,"notices"));
    const list=[];
    snapshot.forEach(item=>{const d=item.data();if(d.published===true)list.push({id:item.id,...d});});
    list.sort((a,b)=>(b.updatedAt||b.createdAt||"").localeCompare(a.updatedAt||a.createdAt||""));
    return list;
  }
  function noticeHtml(d){
    const bg=d.imageUrl ? "background-image:linear-gradient(rgba(0,30,45,.45),rgba(0,30,45,.45)),url('"+String(d.imageUrl).replace(/'/g,"%27")+"');background-size:cover;background-position:center;" : "";
    return "<div style=\"padding:18px;border-radius:14px;color:#fff;min-height:130px;"+bg+"background-color:#087f8c;\"><h3 style=\"margin:0 0 8px;\">📢 "+(d.title||"Notice")+"</h3><div style=\"white-space:pre-wrap;line-height:1.5;\">"+(d.message||"")+"</div></div>";
  }
  async function loadPublishedNotices(){
    const box=document.getElementById("sssNoticeResult");
    try{
      const list=await getPublishedNotices();
      box.innerHTML=list.length?list.map(noticeHtml).join("<div style='height:10px'></div>"):"No published notice available.";
    }catch(e){box.textContent="Notice could not be loaded.";console.error(e);}
  }
  async function loadNotification(){
    const wrap=document.querySelector(".sss-notification-wrap");
    const btn=document.getElementById("sssNotificationBtn"), badge=document.getElementById("sssNotificationBadge");
    try{
      const list=await getPublishedNotices();
      const hasNotice=list.length>0;
      if(wrap) wrap.style.display=hasNotice?"block":"none";
      if(badge){
        badge.textContent=String(list.length);
        badge.style.display=hasNotice?"flex":"none";
      }
      if(btn) btn.classList.toggle("has-notice",hasNotice);
    }catch(e){
      if(wrap) wrap.style.display="none";
      console.error("Notification load error:",e);
    }
  }
  const notificationBtn=document.getElementById("sssNotificationBtn");
  if(notificationBtn) notificationBtn.addEventListener("click",()=>{openTool("sssNoticeModal");loadPublishedNotices();});
  loadNotification();
</script>
