.sss-weather-search button{border:0;border-radius:13px;background:#4d7fc4;color:#fff;padding:0 16px;font-size:19px;cursor:pointer}
.sss-weather-place{font-size:14px;color:#bfc4cf;margin:2px 4px 8px}
