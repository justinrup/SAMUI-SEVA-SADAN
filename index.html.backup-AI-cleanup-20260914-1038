<script>
(function(){
  const btn = document.getElementById("sssFloatingAskAI");
  if(!btn) return;

  btn.addEventListener("click", function(e){
    if(btn.dataset.dragged === "1"){
      btn.dataset.dragged = "0";
      e.preventDefault();
      return;
    }

    const modal = document.getElementById("sssAskAiModal");
    if(modal) modal.classList.add("show");
  });

  let dragging = false;
  let moved = false;
  let startX = 0;
  let startY = 0;
  let startLeft = 0;
  let startTop = 0;

  function pointerDown(e){
    dragging = true;
    moved = false;

    const r = btn.getBoundingClientRect();
    startX = e.clientX;
    startY = e.clientY;
    startLeft = r.left;
    startTop = r.top;

    btn.setPointerCapture?.(e.pointerId);
  }

  function pointerMove(e){
    if(!dragging) return;

    const dx = e.clientX - startX;
    const dy = e.clientY - startY;

    if(Math.abs(dx) > 5 || Math.abs(dy) > 5) moved = true;

    if(!moved) return;

    let left = startLeft + dx;
    let top = startTop + dy;

    left = Math.max(5, Math.min(window.innerWidth - btn.offsetWidth - 5, left));
    top = Math.max(5, Math.min(window.innerHeight - btn.offsetHeight - 5, top));

    btn.style.left = left + "px";
    btn.style.top = top + "px";
    btn.style.right = "auto";
    btn.style.bottom = "auto";
  }

  function pointerUp(){
    if(!dragging) return;
    dragging = false;

    if(moved){
      setTimeout(function(){
        btn.dataset.dragged = "1";
      }, 0);
    }
  }

  btn.addEventListener("pointerdown", pointerDown);
  btn.addEventListener("pointermove", pointerMove);
  btn.addEventListener("pointerup", pointerUp);
  btn.addEventListener("pointercancel", pointerUp);


})();
</script>

