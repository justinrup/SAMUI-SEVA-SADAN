.sss-dob-field{display:flex;align-items:center;gap:10px;cursor:pointer;}
.sss-dob-date-input{flex:1;min-width:0;border:0;background:transparent;font-size:17px;font-weight:700;color:#667;outline:none;padding:8px 0;}
