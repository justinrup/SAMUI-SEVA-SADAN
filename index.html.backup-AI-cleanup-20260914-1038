      "एंटीबायोटिक","गैस","एसिडिटी","डॉक्टर","अस्पताल","स्वास्थ्य",
      "दांत"
    ];

    return medicalWords.some(word => q.includes(word));
  }

  async function answerQuestion(){
    const text = input.value.trim();
    if(!text) return;

    addMessage(text, "user");
    input.value = "";

    addMessage("🤖 Thinking...", "bot");

    const botMessages = chat.querySelectorAll(".sss-askai-message.bot");
    const thinkingBubble =
      botMessages[botMessages.length - 1]?.querySelector(".sss-askai-bubble");

    try {
      const response = await fetch("/api/ask-ai", {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          question: text
        })
      });

      let result = {};

      try {
        result = await response.json();
      } catch(e) {
        throw new Error("AI server returned an invalid response.");
      }

      if(!response.ok || !result.ok){
        throw new Error(
          result.message || "AI service request failed."
        );
      }

      if(thinkingBubble){
        thinkingBubble.textContent =
          result.answer || "No answer received.";
      }else{
        addMessage(
          result.answer || "No answer received.",
          "bot"
        );
      }

    } catch(error) {
      console.error("NEW ASK AI ERROR:", error);

      const message =
        error && error.message
          ? "⚠️ " + error.message
          : "⚠️ AI service is temporarily unavailable. Please try again.";

      if(thinkingBubble){
        thinkingBubble.textContent = message;
      }else{
        addMessage(message, "bot");
      }
    }
  }

  send.addEventListener("click", answerQuestion);

  input.addEventListener("keydown", function(e){
    if(e.key === "Enter"){
      e.preventDefault();
      answerQuestion();
    }
  });

  document.querySelectorAll("[data-ask]").forEach(function(button){
    button.addEventListener("click", function(){
      input.value = button.getAttribute("data-ask") || "";
      answerQuestion();
    });
  });
})();
</script>

