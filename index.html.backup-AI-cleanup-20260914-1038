.sss-weather-lang{display:flex;justify-content:flex-end;align-items:center;gap:7px;margin:2px 2px 10px}.sss-weather-lang select{background:#303238;color:#fff;border:1px solid #555;border-radius:10px;padding:9px 10px;font-size:14px;outline:none}.sss-weather-lang label{font-size:13px;color:#cdd0d8}.sss-weather-search{display:flex;gap:8px;margin-bottom:12px}
