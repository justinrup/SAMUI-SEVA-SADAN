window.toggleDriver = async (id, status) => {
  try {
    await updateDoc(doc(db, "local_drivers", id), {
      published: !status
    });

    await loadDrivers();
  } catch (error) {
    console.error(error);
  }
};

window.deleteDriver = async (id) => {
  if (!confirm("এই Local Driver মুছে ফেলবেন?")) return;

  try {
    await deleteDoc(doc(db, "local_drivers", id));
    await loadDrivers();
  } catch (error) {
    console.error(error);
  }
};

loadDrivers();


// ===== WEBSITE LINK MANAGEMENT =====
