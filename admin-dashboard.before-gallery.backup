      const d = item.data();

      driverName.value = d.name || "";
      driverPhone.value = d.phone || "";

      editingDriverId = id;
      saveDriver.textContent = "💾 Update Local Driver";
      driverMessage.innerHTML = "✏️ Edit mode চালু হয়েছে।";
    }
