  <script type="module" src="js/app.js?v=2"></script>


<script>
document.querySelectorAll(".service-grid .service-card").forEach(card => {
  card.style.cursor = "pointer";
  card.addEventListener("click", () => {
    window.location.href = "admin-dashboard.html";
  });
});
</script>
\n
<section id="homeFacilitiesSection">
  <h2>Our Facilities</h2>
  <div class="services" id="homeFacilities">
    <div class="card">
      <h3>Patient Rooms</h3>
      <p>Comfortable spaces for patient care and recovery.</p>
    </div>
    <div class="card">
      <h3>Nursing Support</h3>
      <p>Dedicated nursing assistance for patients.</p>
    </div>
    <div class="card">
      <h3>Clean Environment</h3>
      <p>A clean and comfortable healthcare environment.</p>
    </div>
    <div class="card">
      <h3>Patient Care</h3>
      <p>Supportive care focused on patient comfort.</p>
    </div>
  </div>
  <p style="margin-top:20px;">
    <a href="facilities.html">View All Facilities →</a>
  </p>
</section>


<script type="module">
import { initializeApp }
from "https://www.gstatic.com/firebasejs/12.2.1/firebase-app.js";

import {
  getFirestore,
  collection,
  getDocs
}
from "https://www.gstatic.com/firebasejs/12.2.1/firebase-firestore.js";

const firebaseConfig = {
  apiKey: "AIzaSyDeJryLHlGc9Mx_kpo1IhmqnLC5EVYGBvM",
  authDomain: "samui-seva-sadan.firebaseapp.com",
  projectId: "samui-seva-sadan",
  storageBucket: "samui-seva-sadan.firebasestorage.app",
  messagingSenderId: "358488171058",
  appId: "1:358488171058:web:8be9c94e38f6618049522b",
  measurementId: "G-ML4BQ4QVLB"
};

const app = initializeApp(firebaseConfig);
const db = getFirestore(app);

async function loadEmergencyNumber() {
  try {
    const snapshot = await getDocs(collection(db, "locations"));

    let emergency = "";

    snapshot.forEach(item => {
      const data = item.data();

      if (data.published && data.emergency) {
        emergency = data.emergency;
      }
    });

    if (emergency) {
      const headerEmergency =
        document.querySelector(".emergency strong");

      const contactEmergency =
        document.querySelector("#contact .contact-card:nth-child(3) p");

      const whatsappNumber =
        emergency.replace(/\D/g, "");

      if (headerEmergency) {
        headerEmergency.innerHTML =
          '📞 <a href="tel:' + whatsappNumber +
          '" style="color:inherit;text-decoration:none;">' +
          emergency +
          '</a> ' +
          '<a href="https://wa.me/' + whatsappNumber +
          '" target="_blank" rel="noopener noreferrer" ' +
          'class="whatsapp-btn" title="WhatsApp">' +
          '<span class="whatsapp-icon">☎</span>' +
          '</a>';
      }

      if (contactEmergency) {
        contactEmergency.innerHTML =
          '<a href="tel:' + whatsappNumber +
          '" style="text-decoration:none;">📞 ' +
          emergency +
          '</a> ' +
          '<a href="https://wa.me/' + whatsappNumber +
          '" target="_blank" rel="noopener noreferrer" ' +
          'class="whatsapp-btn whatsapp-contact" title="WhatsApp">' +
          '<span class="whatsapp-icon">☎</span> WhatsApp</a>';
      }
    }

  } catch (error) {
    console.error("Emergency number load error:", error);
  }
}

loadEmergencyNumber();
</script>


