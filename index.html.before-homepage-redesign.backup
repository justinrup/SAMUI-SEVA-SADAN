<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SAMUI SEVA SADAN NURSING HOME</title>
  <link rel="stylesheet" href="css/style.css">

<style>
.whatsapp-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: #25D366;
  color: white !important;
  text-decoration: none !important;
  margin-left: 6px;
  box-shadow: 0 2px 6px rgba(0,0,0,.25);
  vertical-align: middle;
  transition: transform .2s;
}

.whatsapp-btn:hover {
  transform: scale(1.08);
}

.whatsapp-icon {
  font-size: 20px;
  font-weight: bold;
  line-height: 1;
}

.whatsapp-contact {
  width: auto;
  height: 36px;
  padding: 0 12px;
  border-radius: 20px;
  gap: 6px;
  font-size: 15px;
}
</style>


<style>
/* ===== SAMUI SEVA SADAN 3-DOT MENU ===== */
.sss-menu-button {
  position: fixed;
  left: 10px;
  top: 50%;
  transform: translateY(-50%);
  width: 44px;
  height: 52px;
  border: 0;
  border-radius: 12px;
  background: #0f766e;
  color: #fff;
  font-size: 28px;
  font-weight: bold;
  line-height: 1;
  cursor: pointer;
  z-index: 9999;
  box-shadow: 0 4px 14px rgba(0,0,0,.25);
}

.sss-menu-button:hover {
  transform: translateY(-50%) scale(1.05);
}

.sss-side-menu {
  position: fixed;
  left: 0;
  top: 0;
  width: 285px;
  max-width: 82vw;
  height: 100vh;
  background: #17202a;
  color: #fff;
  z-index: 10000;
  transform: translateX(-105%);
  transition: transform .28s ease;
  box-shadow: 5px 0 20px rgba(0,0,0,.3);
  overflow-y: auto;
}

.sss-side-menu.open {
  transform: translateX(0);
}

.sss-menu-header {
  padding: 20px 18px;
  background: #0f766e;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sss-menu-title {
  font-size: 18px;
  font-weight: 700;
}

.sss-menu-close {
  border: 0;
  background: transparent;
  color: #fff;
  font-size: 28px;
  cursor: pointer;
}

.sss-menu-list {
  padding: 10px 0 25px;
}

.sss-menu-list a {
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 13px 18px;
  color: #fff;
  text-decoration: none;
  font-size: 15px;
  border-bottom: 1px solid rgba(255,255,255,.07);
  transition: background .2s;
}

.sss-menu-list a:hover {
  background: rgba(255,255,255,.10);
}

.sss-menu-icon {
  width: 27px;
  text-align: center;
  font-size: 20px;
}

.sss-menu-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.45);
  z-index: 9998;
  display: none;
}

.sss-menu-overlay.show {
  display: block;
}

@media (max-width: 600px) {
  .sss-menu-button {
    left: 7px;
    width: 42px;
    height: 48px;
  }
}
</style>


<style id="sss-menu-fix">
/* 3-dot button beside Home */
.sss-menu-button{
  position:relative !important;
  left:auto !important;
  top:auto !important;
  transform:none !important;
  width:52px !important;
  height:52px !important;
  margin-left:-8px !important;
  padding:0 !important;
  display:inline-flex !important;
  align-items:center !important;
  justify-content:center !important;
  vertical-align:middle !important;
  font-size:38px !important;
  line-height:1 !important;
  border-radius:10px !important;
  cursor:pointer !important;
}

/* Menu item = icon + name */
.sss-menu-list a{
  display:flex !important;
  align-items:center !important;
  gap:14px !important;
  padding:15px 20px !important;
  font-size:17px !important;
  font-weight:500 !important;
}

.sss-menu-list a span{
  display:inline-block !important;
  min-width:28px !important;
  text-align:center !important;
  font-size:22px !important;
}

.sss-menu-list a .sss-menu-text{
  display:inline-block !important;
  color:white !important;
}
</style>


<style id="sss-edge-fix">
.navbar{
  position:relative !important;
  padding-left:68px !important;
}

.navbar .sss-menu-button{
  position:absolute !important;
  left:0 !important;
  top:50% !important;
  transform:translateY(-50%) !important;
  margin:0 !important;
  width:58px !important;
  height:58px !important;
  font-size:38px !important;
  z-index:20 !important;
}
</style>


<style id="sss-menu-names">
.sss-menu-list a{
  display:flex !important;
  align-items:center !important;
  gap:14px !important;
  padding:15px 20px !important;
  color:#fff !important;
  text-decoration:none !important;
  font-size:17px !important;
}
.sss-menu-list a span{
  width:30px !important;
  min-width:30px !important;
  text-align:center !important;
  font-size:23px !important;
}
.sss-menu-list a b{
  color:#fff !important;
  font-weight:500 !important;
}
</style>


<style id="sss-visible-menu-names">
.sss-menu-list a,
.sss-menu-list a b,
.sss-menu-list a span {
  color: #123 !important;
}

.sss-menu-list a {
  display: flex !important;
  align-items: center !important;
  gap: 14px !important;
  padding: 15px 20px !important;
  text-decoration: none !important;
}

.sss-menu-list a b {
  display: inline-block !important;
  color: #123 !important;
  font-size: 17px !important;
  font-weight: 600 !important;
}
</style>


<style id="sss-final-menu-text">
.sss-menu-list a {
  display:flex !important;
  align-items:center !important;
  gap:14px !important;
  padding:15px 20px !important;
  text-decoration:none !important;
}
.sss-menu-list a span {
  display:inline-block !important;
  width:30px !important;
  min-width:30px !important;
  text-align:center !important;
  font-size:23px !important;
}
.sss-menu-list a b {
  display:inline-block !important;
  color:#ffffff !important;
  font-size:17px !important;
  font-weight:600 !important;
}
</style>


<style id="sss-clean-menu">
.sss-side-menu{
  width:320px !important;
  max-width:85vw !important;
  overflow-y:auto !important;
}

.sss-menu-list{
  display:block !important;
  width:100% !important;
}

.sss-menu-list a{
  display:flex !important;
  flex-direction:row !important;
  align-items:center !important;
  gap:14px !important;
  width:100% !important;
  padding:15px 20px !important;
  color:#fff !important;
  text-decoration:none !important;
  white-space:nowrap !important;
}

.sss-menu-list a span{
  display:inline-block !important;
  width:32px !important;
  min-width:32px !important;
  font-size:23px !important;
  text-align:center !important;
}

.sss-menu-list a b{
  display:inline-block !important;
  color:#fff !important;
  font-size:17px !important;
  font-weight:600 !important;
  visibility:visible !important;
  opacity:1 !important;
}
</style>


<style id="sss-menu-text-dark">
.sss-side-menu .sss-menu-list a {
  color: #123 !important;
}

.sss-side-menu .sss-menu-list a b {
  color: #123 !important;
  display: inline-block !important;
  visibility: visible !important;
  opacity: 1 !important;
  font-size: 17px !important;
  font-weight: 700 !important;
}

.sss-side-menu .sss-menu-list a span {
  display: inline-block !important;
  visibility: visible !important;
  opacity: 1 !important;
}
</style>

</head>

<body>

