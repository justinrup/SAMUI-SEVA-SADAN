<a href="settings.html"><span>⚙️</span><b>Settings</b></a>
</nav>
</aside>

<script>
(function () {
  const button = document.getElementById("sssMenuButton");
  const menu = document.getElementById("sssSideMenu");
  const close = document.getElementById("sssMenuClose");
  const overlay = document.getElementById("sssMenuOverlay");

  function openMenu() {
    menu.classList.add("open");
    overlay.classList.add("show");
  }

  function closeMenu() {
    menu.classList.remove("open");
    overlay.classList.remove("show");
  }

  button.addEventListener("click", openMenu);
  close.addEventListener("click", closeMenu);
  overlay.addEventListener("click", closeMenu);

  document.querySelectorAll(".sss-menu-list a").forEach(function (link) {
    link.addEventListener("click", closeMenu);
  });
})();
</script>

</body>
</html>
