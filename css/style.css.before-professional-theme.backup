* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #f4fbfb;
  color: #173b3b;
  line-height: 1.6;
}

header {
  background: #087f8c;
  color: white;
  padding: 18px 5%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  flex-wrap: wrap;
}

header h1 {
  margin: 0;
  font-size: 25px;
}

header p {
  margin: 3px 0 0;
}

nav {
  background: white;
  padding: 12px 5%;
  display: flex;
  gap: 18px;
  flex-wrap: wrap;
  box-shadow: 0 2px 10px #0002;
  position: sticky;
  top: 0;
  z-index: 10;
}

nav a {
  color: #087f8c;
  text-decoration: none;
  font-weight: bold;
}

.hero {
  min-height: 430px;
  padding: 55px 5%;
  display: flex;
  align-items: center;
  background: white;
}

.hero-text {
  width: 50%;
  padding-right: 30px;
}

.hero h2 {
  font-size: 42px;
  color: #087f8c;
  margin: 10px 0;
}

.hero-image {
  width: 50%;
}

.hero-image img {
  width: 100%;
  max-height: 390px;
  object-fit: cover;
  border-radius: 18px;
  box-shadow: 0 8px 25px #0003;
}

section {
  padding: 45px 5%;
}

section h2 {
  color: #087f8c;
}

.search-box {
  background: white;
  padding: 25px;
  border-radius: 15px;
  box-shadow: 0 3px 15px #0002;
}

.search-box input {
  width: 70%;
  padding: 13px;
  border: 1px solid #bbb;
  border-radius: 8px;
}

button {
  padding: 13px 20px;
  border: 0;
  border-radius: 8px;
  background: #087f8c;
  color: white;
  font-weight: bold;
  cursor: pointer;
}

.services {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  gap: 20px;
}

.card {
  background: white;
  padding: 24px;
  border-radius: 15px;
  box-shadow: 0 3px 15px #0002;
  border-top: 4px solid #087f8c;
}

.card h3 {
  color: #087f8c;
}

.contact {
  background: #e5f7f7;
}

footer {
  background: #075e68;
  color: white;
  text-align: center;
  padding: 25px;
}

@media (max-width: 750px) {
  .hero {
    flex-direction: column;
  }

  .hero-text,
  .hero-image {
    width: 100%;
    padding: 0;
  }

  .hero h2 {
    font-size: 30px;
  }

  .search-box input {
    width: 100%;
    margin-bottom: 10px;
  }
}

.service-card {
  display: block;
  background: white;
  padding: 24px;
  border-radius: 15px;
  box-shadow: 0 3px 15px #0002;
  border-top: 4px solid #087f8c;
  text-decoration: none;
  color: #173b3b;
  transition: transform 0.2s, box-shadow 0.2s;
}

.service-card h3 {
  color: #087f8c;
}

.service-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 6px 20px #0003;
}
