* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  background: #f7fbfc;
  color: #173b4d;
  line-height: 1.6;
}

/* ================= HEADER ================= */

.top-header {
  background: linear-gradient(135deg, #087f8c, #075985);
  color: #fff;
  padding: 14px 6%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  box-shadow: 0 4px 18px rgba(0,0,0,.12);
  position: relative;
  z-index: 1000;
}

.brand {
  display: flex;
  align-items: center;
  gap: 14px;
}

.logo {
  width: 58px;
  height: 58px;
  border-radius: 15px;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 31px;
  box-shadow: 0 4px 12px rgba(0,0,0,.18);
}

.brand h1 {
  font-size: 22px;
  font-weight: 800;
  letter-spacing: .4px;
}

.brand p {
  font-size: 12px;
  opacity: .9;
  letter-spacing: 1.5px;
}

.emergency {
  background: #fff;
  color: #c62828;
  padding: 10px 17px;
  border-radius: 30px;
  font-weight: 800;
  box-shadow: 0 4px 15px rgba(0,0,0,.15);
}

.emergency strong {
  margin-left: 5px;
}

/* ================= NAVIGATION ================= */

.navbar {
  background: #fff;
  min-height: 62px;
  padding: 0 6%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 28px;
  box-shadow: 0 3px 15px rgba(0,0,0,.07);
  position: sticky;
  top: 0;
  z-index: 999;
}

.navbar > a {
  color: #17495b;
  text-decoration: none;
  font-weight: 700;
  font-size: 14px;
  padding: 20px 3px;
  transition: .25s;
}

.navbar > a:hover {
  color: #087f8c;
}

/* 3 DOT MENU */

.sss-menu-button {
  border: 0;
  background: #087f8c;
  color: #fff;
  width: 46px;
  height: 46px;
  border-radius: 12px;
  font-size: 29px;
  font-weight: bold;
  cursor: pointer;
  box-shadow: 0 4px 12px rgba(0,0,0,.16);
}

.sss-menu-button:hover {
  background: #075985;
}

.sss-side-menu {
  position: fixed;
  left: 0;
  top: 0;
  width: 320px;
  max-width: 85vw;
  height: 100vh;
  background: #fff;
  color: #123;
  z-index: 10000;
  transform: translateX(-105%);
  transition: transform .28s ease;
  box-shadow: 5px 0 25px rgba(0,0,0,.25);
  overflow-y: auto;
}

.sss-side-menu.open {
  transform: translateX(0);
}

.sss-menu-header {
  padding: 20px;
  background: linear-gradient(135deg,#087f8c,#075985);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sss-menu-title {
  font-weight: 800;
}

.sss-menu-close {
  border: 0;
  background: transparent;
  color: #fff;
  font-size: 30px;
  cursor: pointer;
}

.sss-menu-list {
  padding: 8px 0 25px;
}

.sss-menu-list a {
  display: flex !important;
  align-items: center !important;
  gap: 14px !important;
  padding: 15px 20px !important;
  color: #173b4d !important;
  text-decoration: none !important;
  font-size: 16px !important;
  border-bottom: 1px solid #edf3f4;
}

.sss-menu-list a:hover {
  background: #eef9fa;
  color: #087f8c !important;
}

.sss-menu-list a span {
  width: 30px !important;
  min-width: 30px !important;
  text-align: center;
  font-size: 22px;
}

.sss-menu-list a b {
  color: inherit !important;
  font-weight: 700;
}

/* ================= HERO ================= */

.hero {
  min-height: 570px;
  padding: 75px 6%;
  display: flex;
  align-items: center;
  gap: 60px;
  background:
    radial-gradient(circle at 5% 15%, rgba(8,127,140,.13), transparent 32%),
    radial-gradient(circle at 95% 80%, rgba(7,89,133,.12), transparent 32%),
    #eff9fa;
}

.hero-text {
  flex: 1;
  max-width: 610px;
}

.welcome {
  display: inline-block;
  color: #087f8c;
  background: #d9f4f5;
  padding: 8px 17px;
  border-radius: 30px;
  font-size: 13px;
  font-weight: 800;
  margin-bottom: 17px;
}

.hero h2 {
  font-size: clamp(34px, 5vw, 60px);
  line-height: 1.05;
  color: #123d55;
  margin-bottom: 20px;
}

.hero p {
  font-size: 17px;
  color: #58717d;
  max-width: 560px;
  margin-bottom: 28px;
}

.hero-buttons {
  display: flex;
  gap: 13px;
  flex-wrap: wrap;
}

.btn {
  display: inline-block;
  text-decoration: none;
  border: 0;
  cursor: pointer;
  padding: 13px 23px;
  border-radius: 30px;
  font-weight: 800;
  transition: .25s;
}

.btn,
.btn-primary {
  background: linear-gradient(135deg,#087f8c,#075985);
  color: #fff;
  box-shadow: 0 7px 20px rgba(8,127,140,.23);
}

.btn:hover {
  transform: translateY(-2px);
}

.btn.secondary,
.btn-secondary {
  background: #fff;
  color: #075985;
  border: 1px solid #b8dfe3;
  box-shadow: none;
}

.hero-image {
  flex: 1;
  max-width: 600px;
}

.hero-image img {
  width: 100%;
  max-height: 400px;
  object-fit: cover;
  border-radius: 28px;
  display: block;
  border: 7px solid #fff;
  box-shadow: 0 20px 50px rgba(16,65,85,.22);
}

/* ================= COMMON SECTIONS ================= */

section {
  padding: 72px 6%;
}

.section-title {
  text-align: center;
  margin-bottom: 40px;
}

.section-title > span,
.section-title > :first-child:not(h2) {
  color: #087f8c;
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 1.4px;
}

.section-title h2 {
  color: #123d55;
  font-size: 34px;
  margin-top: 5px;
  margin-bottom: 8px;
}

.section-title p {
  color: #6a828c;
}

/* ================= SEARCH ================= */

.search-section {
  background: #fff;
  text-align: center;
}

.search-section > h2 {
  color: #123d55;
  margin-bottom: 20px;
}

.search-box {
  max-width: 850px;
  margin: auto;
  padding: 22px;
  background: #eef9fa;
  border: 1px solid #cdecef;
  border-radius: 22px;
  box-shadow: 0 8px 28px rgba(0,0,0,.06);
  display: flex;
  gap: 10px;
}

.search-box input {
  flex: 1;
  min-width: 0;
  border: 1px solid #c8e1e5;
  border-radius: 13px;
  padding: 13px 15px;
  font-size: 15px;
  outline: none;
}

.search-box input:focus {
  border-color: #087f8c;
}

.search-box button {
  border: 0;
  border-radius: 13px;
  padding: 0 25px;
  background: #087f8c;
  color: #fff;
  font-weight: 800;
  cursor: pointer;
}

#searchResult {
  margin-top: 15px;
  color: #687f89;
}

/* ================= SERVICES ================= */

#services,
.services {
  background: #f7fbfc;
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(4,1fr);
  gap: 22px;
}

.service-card,
.card {
  display: block;
  background: #fff;
  border: 1px solid #e0edef;
  border-radius: 20px;
  padding: 28px 20px;
  text-align: center;
  text-decoration: none;
  box-shadow: 0 8px 24px rgba(16,65,85,.07);
  transition: .25s;
  color: inherit;
}

.service-card:hover,
.card:hover {
  transform: translateY(-7px);
  box-shadow: 0 16px 35px rgba(16,65,85,.14);
}

.service-card > div:first-child {
  font-size: 40px;
  margin-bottom: 8px;
}

.service-card h3,
.card h3 {
  color: #075985;
  margin: 7px 0;
}

.service-card p,
.card p {
  color: #6b818a;
  font-size: 14px;
}

/* ================= DOCTORS ================= */

.info-section {
  background: #fff;
}

.info-section > div:first-child {
  text-align: center;
  margin-bottom: 35px;
}

.info-section > div:first-child > span {
  color: #087f8c;
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 1.3px;
}

.info-section h2 {
  color: #123d55;
  font-size: 34px;
  margin: 5px 0;
}

.info-section > div:first-child p {
  color: #6b818a;
}

.doctor-box {
  max-width: 1000px;
  margin: auto;
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 20px;
}

.doctor-public-card {
  background: #f5fbfc;
  border: 1px solid #dceff1;
  border-radius: 20px;
  padding: 25px;
  text-align: center;
  box-shadow: 0 7px 20px rgba(0,0,0,.05);
}

.doctor-public-card .doctor-icon {
  font-size: 45px;
  margin-bottom: 10px;
}

.doctor-public-card h3 {
  color: #075985;
  margin-bottom: 10px;
}

.doctor-public-card p {
  color: #607985;
  font-size: 14px;
  margin: 4px 0;
}

/* ================= CONTACT ================= */

.contact-section {
  background: #eff9fa;
}

.contact-grid {
  display: grid;
  grid-template-columns: repeat(4,1fr);
  gap: 20px;
}

.contact-card {
  background: #fff;
  border: 1px solid #dceff1;
  border-radius: 20px;
  padding: 26px 20px;
  text-align: center;
  box-shadow: 0 8px 22px rgba(0,0,0,.06);
}

.contact-card strong {
  color: #075985;
  display: block;
  margin-bottom: 9px;
}

.contact-card p {
  color: #607985;
  font-size: 14px;
  word-break: break-word;
}

/* ================= MAP ================= */

.map-section {
  background: #fff;
}

.map-placeholder {
  max-width: 1100px;
  min-height: 300px;
  margin: auto;
  border-radius: 24px;
  background: #eaf6f7;
  border: 2px dashed #9ccfd5;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: #47717c;
}

.map-icon {
  font-size: 45px;
  margin-bottom: 8px;
}

/* ================= FACILITIES ================= */

#homeFacilitiesSection {
  background: #f7fbfc;
}

#homeFacilitiesSection > h2 {
  text-align: center;
  color: #123d55;
  font-size: 34px;
  margin-bottom: 30px;
}

#homeFacilitiesSection .services {
  display: grid;
  grid-template-columns: repeat(4,1fr);
  gap: 20px;
  background: transparent;
}

#homeFacilitiesSection .card {
  padding: 27px 20px;
}

/* ================= WHATSAPP ================= */

.whatsapp-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 35px;
  height: 35px;
  border-radius: 50%;
  background: #25d366;
  color: #fff !important;
  text-decoration: none !important;
  margin-left: 6px;
  box-shadow: 0 3px 8px rgba(0,0,0,.2);
}

.whatsapp-contact {
  width: auto;
  height: 37px;
  padding: 0 13px;
  border-radius: 22px;
  gap: 6px;
}

.whatsapp-icon {
  font-size: 19px;
}

.whatsapp-float {
  position: fixed;
  right: 20px;
  bottom: 20px;
  width: 59px;
  height: 59px;
  border-radius: 50%;
  background: #25d366;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  font-size: 28px;
  box-shadow: 0 6px 20px rgba(0,0,0,.22);
  z-index: 2000;
}

/* ================= FOOTER ================= */

footer {
  background: #123d55;
  color: #fff;
  text-align: center;
  padding: 48px 6% 25px;
}

footer h2 {
  font-size: 24px;
  margin-bottom: 8px;
}

footer p {
  color: #c9e1e6;
}

footer .copyright {
  margin-top: 22px;
  padding-top: 18px;
  border-top: 1px solid rgba(255,255,255,.15);
  font-size: 13px;
}

/* ================= MOBILE ================= */

@media (max-width: 900px) {
  .hero {
    flex-direction: column;
    text-align: center;
    padding-top: 55px;
  }

  .hero-text {
    max-width: 700px;
  }

  .hero-buttons {
    justify-content: center;
  }

  .hero-image {
    width: 100%;
  }

  .service-grid,
  .contact-grid {
    grid-template-columns: repeat(2,1fr);
  }

  .doctor-box {
    grid-template-columns: repeat(2,1fr);
  }

  .navbar {
    gap: 13px;
    padding: 0 3%;
  }

  .navbar > a {
    font-size: 12px;
  }
}

@media (max-width: 600px) {
  .top-header {
    padding: 12px 4%;
  }

  .brand h1 {
    font-size: 17px;
  }

  .brand p {
    font-size: 10px;
  }

  .logo {
    width: 48px;
    height: 48px;
    font-size: 25px;
  }

  .emergency {
    font-size: 11px;
    padding: 8px 10px;
  }

  .navbar {
    min-height: 55px;
    justify-content: flex-start;
    overflow-x: auto;
    white-space: nowrap;
  }

  .navbar > a {
    padding: 17px 2px;
    font-size: 12px;
  }

  .sss-menu-button {
    flex: 0 0 auto;
    width: 43px;
    height: 43px;
    font-size: 27px;
  }

  .hero {
    padding: 48px 5%;
    min-height: auto;
    gap: 35px;
  }

  .hero h2 {
    font-size: 35px;
  }

  .hero p {
    font-size: 15px;
  }

  section {
    padding: 55px 5%;
  }

  .section-title h2,
  .info-section h2,
  #homeFacilitiesSection > h2 {
    font-size: 28px;
  }

  .search-box {
    flex-direction: column;
    padding: 16px;
  }

  .search-box button {
    height: 45px;
  }

  .service-grid,
  .contact-grid,
  .doctor-box,
  #homeFacilitiesSection .services {
    grid-template-columns: 1fr;
  }

  .sss-side-menu {
    width: 300px;
  }

  .whatsapp-float {
    right: 14px;
    bottom: 14px;
  }
}

/* Real Google Map */
.real-map-box {
  max-width: 1100px;
  margin: 0 auto;
  background: #fff;
  border-radius: 22px;
  overflow: hidden;
  border: 1px solid #d8edef;
  box-shadow: 0 10px 30px rgba(0,0,0,.08);
}

.real-map-box iframe {
  display: block;
  width: 100%;
  min-height: 400px;
}

.map-actions {
  padding: 16px;
  text-align: center;
  background: #fff;
}

.map-direction-btn {
  display: inline-block;
  padding: 12px 24px;
  border-radius: 30px;
  background: linear-gradient(135deg, #087f8c, #075985);
  color: #fff;
  text-decoration: none;
  font-weight: 800;
  box-shadow: 0 5px 15px rgba(8,127,140,.20);
  transition: .25s;
}

.map-direction-btn:hover {
  transform: translateY(-2px);
}

@media (max-width: 600px) {
  .real-map-box iframe {
    min-height: 320px;
  }
}

